<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application>
        <!-- Hands a shared page image to the app the user picked. -->
        <provider
            android:name="app.picacgmd.feature.reader.media.ReaderFileProvider"
            android:authorities="${applicationId}.reader.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
